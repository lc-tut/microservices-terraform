# direnv 用環境変数ファイル
# cp local/.envrc.example .envrc && direnv allow
# または source local/.envrc.example でも可

# ---- MinIO S3 バックエンド（ローカル） ----
# 本番では GitHub Secrets に登録した Ceph RGW の値が CI で自動設定される
export AWS_ENDPOINT_URL_S3=http://localhost:19000
export AWS_ACCESS_KEY_ID=minioadmin
export AWS_SECRET_ACCESS_KEY=minioadmin
export AWS_DEFAULT_REGION=us-east-1

# ---- SMTP 設定（terraform/platform/idp/ のメール送信ステージ） ----
# 未設定の場合は Authentik コンテナの AUTHENTIK_EMAIL__* 環境変数にフォールバックする
# export TF_VAR_smtp_host=smtp.gmail.com
# export TF_VAR_smtp_port=587
# export TF_VAR_smtp_username=your-account@gmail.com
# export TF_VAR_smtp_password=your-app-password
# export TF_VAR_smtp_use_tls=true
# export TF_VAR_smtp_from_address=noreply@example.com

# ---- OpenStack（GCP DevStack、IAP トンネル起動後に有効） ----
export OS_CLIENT_CONFIG_FILE="$(pwd)/local/clouds.yaml"
export OS_CLOUD=gcp-devstack
export ALL_PROXY=socks5h://localhost:1080
export NO_PROXY=localhost,127.0.0.1
export no_proxy=localhost,127.0.0.1
