# このファイルを config.env にコピーして値を入力する
# config.env は .gitignore 済み（コミットしないこと）
#
# 値は `terraform output` で確認できる（local/gcp-devstack/ で実行）:
#   terraform output project_id
#   terraform output zone
#   terraform output instance_name

PROJECT_ID="<gcp-project-id>"
ZONE="us-central1-a"
INSTANCE_NAME="devstack-harbor"
