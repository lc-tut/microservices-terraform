# GitHub Actions をローカルで実行するための Secrets ファイル（act 用）
# このファイルを local/.secrets にコピーして値を入力してください
# local/.secrets は .gitignore 済みです

# ローカル Authentik (http://localhost:9000) の API トークン
# 管理画面 → Directory → Tokens → Create で取得
AUTHENTIK_TOKEN=

# local/clouds.yaml の認証情報（gcp-devstack クラウド）
# openstack application credential show <name> で確認
LC_CLOUD_APP_CRED_ID=
LC_CLOUD_APP_CRED_SECRET=

# SOPS 復号キー（age-keygen で生成した秘密鍵）
# AGE-SECRET-KEY-... の形式
SOPS_AGE_KEY=
