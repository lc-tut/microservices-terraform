# ローカル開発用プロバイダー設定
# このファイルを terraform/local-override.tf にコピーして使う
# 本番環境では削除すること（.gitignore 済み）

provider "openstack" {
  # local/clouds.yaml の cloud 名を指定する（認証情報はそちらで管理）
  # ~/.config/openstack/clouds.yaml でも可
  cloud = "gk41-poc"
}

provider "authentik" {
  url   = "http://localhost:9000"
  token = ""  # Authentik 管理画面で生成したトークンを入れる
}

provider "vault" {
  address = "http://localhost:8200"
  token   = "root"
}
