# act 用 環境変数ファイル
# このファイルを local/.act.env にコピーしてください
# local/.act.env は .gitignore 済みです
#
# 前提: local/start.sh で MinIO が起動していること（port 19000）

# ローカル S3 バックエンド（MinIO）
AWS_ENDPOINT_URL_S3=http://localhost:19000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

# ---- SMTP 設定（terraform/platform/idp/ のメール送信ステージ） ----
# 未設定の場合は Authentik コンテナの AUTHENTIK_EMAIL__* 環境変数にフォールバックする
# TF_VAR_smtp_host=smtp.gmail.com
# TF_VAR_smtp_port=587
# TF_VAR_smtp_username=your-account@gmail.com
# TF_VAR_smtp_password=your-app-password
# TF_VAR_smtp_use_tls=true
# TF_VAR_smtp_from_address=noreply@example.com
