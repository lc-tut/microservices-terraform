PG_PASS=localdev
AUTHENTIK_SECRET_KEY=change-me-generate-with-openssl-rand-base64-36
# akadmin の初期パスワード。設定しておくと初回起動時に自動作成され、
# Web UI (http://localhost:9000/if/flow/initial-setup/) での手動セットアップが不要になる
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me-generate-with-openssl-rand-base64-24
# akadmin 用 API トークンを起動時に自動作成する（Terraform プロバイダーや act の
# AUTHENTIK_TOKEN に使い回せる。Web UI での手動トークン発行が不要になる）
AUTHENTIK_BOOTSTRAP_TOKEN=change-me-generate-with-openssl-rand-hex-32
