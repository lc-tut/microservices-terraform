# Claude Code personal settings (machine-local)
.claude/settings.local.json

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version
# control as they are data points which are potentially sensitive and subject
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
*tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Optional: ignore graph output files generated by `terraform graph`
# *.dot

# Optional: ignore plan files saved before destroying Terraform configuration
# Uncomment the line below if you want to ignore planout files.
# planout

# ローカル開発用 provider override（本番では使わない）
terraform/local-override.tf

# idp-infra が生成する Authentik VM の SSH 秘密鍵
terraform/platform/infra/idp-infra/.ssh/

# ローカル開発環境の秘密情報
local/authentik/.env
local/.env
local/clouds.yaml
# Polaris 実機のアクセス情報・秘密鍵（コントロールノード SSH / admin パスワード等）
local/polaris-access.md
local/polaris/

# CloudKitty 基盤 VM の SSH 秘密鍵（idp-infra と同じ方針。設定自体は
# cloud-init 経由で Terraform state にのみ保存され、リポジトリには含まれない）
terraform/platform/infra/cloudkitty-infra/.ssh/
# prometheus-infra（cloudkitty-infra から分離した Prometheus 基盤）
terraform/platform/infra/prometheus-infra/.ssh/
# harbor-infra（Harbor VM）の SSH 秘密鍵
terraform/platform/infra/harbor-infra/.ssh/
local/gcp-devstack/windows-autostop/config.env
local/gcp-devstack/windows-autostop/*.vbs
local/.secrets
local/.act.env
.envrc

# SOPS 復号後の平文（絶対に含めない）
*.dec
*_secrets.yaml
# ob-og/alumni は auto-gen-*.yaml も暗号化対象（卒業後の匿名化）。復号後の平文を除外
# active/ 配下の同名ファイルは平文のまま管理するのでここでは無視しない
terraform/platform/members/ob-og/**/auto-gen-*.yaml
terraform/platform/members/alumni/**/auto-gen-*.yaml

# OS
.DS_Store
Thumbs.db